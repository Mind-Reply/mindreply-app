# Template only. Use secret-manager values locally or in the deployment platform.
# Do not add credentials, project identifiers, account IDs, or real endpoints here.

NODE_ENV=development
NEXT_TELEMETRY_DISABLED=1
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

LEGAL_ENTITY_API_URL=https://legal-entity-provider.example/v1
AGENT_WALLET_ADDRESS=REPLACE_IN_SECRET_MANAGER
AGENT_SESSION_KEY=REPLACE_IN_SECRET_MANAGER

SUPABASE_URL=https://PROJECT_REF.supabase.co
SUPABASE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
SUPABASE_JWKS_URL=https://PROJECT_REF.supabase.co/auth/v1/.well-known/jwks.json
SUPABASE_SECRET_KEY=REPLACE_IN_SECRET_MANAGER
SUPABASE_DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/DATABASE

LITELLM_API_URL=http://litellm:4000
QDRANT_API_URL=http://qdrant:6333
SEARXNG_API_URL=http://searxng:8080
BROWSERLESS_URL=ws://browserless:3000
