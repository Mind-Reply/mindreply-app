# ===== APPLICATION =====
NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://mind-reply.com
NEXT_PUBLIC_API_URL=https://api.mind-reply.com

# ===== DATABASE =====
# Primary database for application state
DATABASE_URL=postgresql://mindreply:${DB_PASSWORD}@postgres.railway.app:5432/mindreply?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_REAP_INTERVAL=1000

# ===== REDIS/CACHE =====
REDIS_URL=redis://:${REDIS_PASSWORD}@redis.railway.app:6379/0?ssl=true
REDIS_TTL=3600
REDIS_MAX_RETRY_ATTEMPTS=3

# ===== AUTHENTICATION =====
NEXTAUTH_URL=https://mind-reply.com
NEXTAUTH_SECRET=${NEXTAUTH_SECRET_KEY}

# Clerk Authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=${CLERK_PUBLISHABLE_KEY}
CLERK_SECRET_KEY=${CLERK_SECRET_KEY}
CLERK_API_KEY=${CLERK_API_KEY}
CLERK_WEBHOOK_SECRET=${CLERK_WEBHOOK_SECRET}

# ===== PAYMENT PROCESSING =====
# Stripe production keys
STRIPE_SECRET_KEY=sk_live_${STRIPE_LIVE_SECRET}
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_${STRIPE_LIVE_PUBLISHABLE}
STRIPE_WEBHOOK_SECRET=whsec_${STRIPE_WEBHOOK_SECRET}

# Subscription tier IDs
STRIPE_PRODUCT_STARTER=prod_${STARTER_PRODUCT_ID}
STRIPE_PRODUCT_PRO=prod_${PRO_PRODUCT_ID}
STRIPE_PRODUCT_ENTERPRISE=prod_${ENTERPRISE_PRODUCT_ID}

# ===== EXTERNAL APIS =====
# OpenAI / LLM
OPENAI_API_KEY=sk_${OPENAI_KEY}
OPENAI_ORG_ID=${OPENAI_ORG}
ANTHROPIC_API_KEY=sk_ant_${ANTHROPIC_KEY}

# Vercel Storage & Analytics
VERCEL_BLOB_TOKEN=${VERCEL_BLOB_READ_WRITE_TOKEN}
VERCEL_KV_REST_API_URL=${VERCEL_KV_REST_API_URL}
VERCEL_KV_REST_API_TOKEN=${VERCEL_KV_REST_API_TOKEN}

# ===== MONITORING & LOGGING =====
# Sentry error tracking
SENTRY_AUTH_TOKEN=${SENTRY_AUTH_TOKEN}
NEXT_PUBLIC_SENTRY_DSN=${SENTRY_DSN}

# Datadog APM
DD_TRACE_ENABLED=true
DD_API_KEY=${DATADOG_API_KEY}
DD_SITE=datadoghq.com

# Logtail logging
LOGTAIL_TOKEN=${LOGTAIL_SOURCE_TOKEN}

# ===== RWA BRIDGE =====
AGENT_WALLET_ADDRESS=${ETHEREUM_WALLET_ADDRESS}
AGENT_SESSION_KEY=${SESSION_PRIVATE_KEY}
LEGAL_ENTITY_API_URL=https://api.legal-entity-provider.com
RWA_CONTRACT_ADDRESS=0x${RWA_CONTRACT_ADDRESS}

# ===== WEBHOOKS & INTEGRATIONS =====

# ===== EMAIL SERVICE =====
RESEND_API_KEY=${RESEND_API_KEY}
EMAIL_FROM=noreply@mind-reply.com
SUPPORT_EMAIL=support@mind-reply.com

# ===== FEATURE FLAGS =====
FEATURE_BETA_USERS=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_CUSTOM_BRANDING=true

# ===== PERFORMANCE =====
ISR_REVALIDATE_SECONDS=3600
ISR_REVALIDATE_ON_DEMAND=true
CACHE_STRATEGY=hybrid

# ===== SECURITY =====
CSP_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000

# ===== VERCEL DEPLOYMENT =====
VERCEL_ENV=production
VERCEL_GIT_REPO_OWNER=angellllkr-eng
VERCEL_GIT_REPO_SLUG=mind-reply-core
