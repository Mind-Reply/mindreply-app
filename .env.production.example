# Production template only. Set all real values in the hosting platform secret store.
# Do not insert account-specific values, keys, webhook URLs, or deployment ownership here.

NODE_ENV=production
NEXT_PUBLIC_APP_URL=https://YOUR_PRODUCTION_DOMAIN
NEXT_PUBLIC_API_URL=https://YOUR_API_DOMAIN
DATABASE_URL=postgresql://USER:ENCODED_PASSWORD@HOST:5432/DATABASE?sslmode=require
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=20
DATABASE_POOL_IDLE_TIMEOUT=30000
DATABASE_POOL_REAP_INTERVAL=1000
REDIS_URL=rediss://:PASSWORD@HOST:6379/0
REDIS_TTL=3600
REDIS_MAX_RETRY_ATTEMPTS=3

NEXTAUTH_URL=https://YOUR_PRODUCTION_DOMAIN
NEXTAUTH_SECRET=REPLACE_IN_SECRET_MANAGER
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
CLERK_SECRET_KEY=REPLACE_IN_SECRET_MANAGER
CLERK_API_KEY=REPLACE_IN_SECRET_MANAGER
CLERK_WEBHOOK_SECRET=REPLACE_IN_SECRET_MANAGER

STRIPE_SECRET_KEY=REPLACE_IN_SECRET_MANAGER
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=REPLACE_WITH_PUBLISHABLE_KEY
STRIPE_WEBHOOK_SECRET=REPLACE_IN_SECRET_MANAGER
STRIPE_PRODUCT_STARTER=REPLACE_WITH_PRODUCT_ID
STRIPE_PRODUCT_PRO=REPLACE_WITH_PRODUCT_ID
STRIPE_PRODUCT_ENTERPRISE=REPLACE_WITH_PRODUCT_ID

OPENAI_API_KEY=REPLACE_IN_SECRET_MANAGER
ANTHROPIC_API_KEY=REPLACE_IN_SECRET_MANAGER
VERCEL_BLOB_TOKEN=REPLACE_IN_SECRET_MANAGER
VERCEL_KV_REST_API_URL=https://YOUR_KV_ENDPOINT
VERCEL_KV_REST_API_TOKEN=REPLACE_IN_SECRET_MANAGER
SENTRY_AUTH_TOKEN=REPLACE_IN_SECRET_MANAGER
NEXT_PUBLIC_SENTRY_DSN=https://PUBLIC_DSN@example.invalid/PROJECT
RESEND_API_KEY=REPLACE_IN_SECRET_MANAGER
EMAIL_FROM=noreply@YOUR_PRODUCTION_DOMAIN
SUPPORT_EMAIL=support@YOUR_PRODUCTION_DOMAIN

FEATURE_BETA_USERS=false
FEATURE_ADVANCED_ANALYTICS=false
FEATURE_CUSTOM_BRANDING=false
CSP_ENABLED=true
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000
VERCEL_ENV=production
