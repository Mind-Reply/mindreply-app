# Elysium runtime — copy to .env.local (never commit secrets)

# Enable Profit Audit gate path (default off = safe no-op)
ELYSIUM_AUDIT_LOOP=0

# Veridex Supabase ledger (server-only; never expose service role to browser)
# VERIDEX_SUPABASE_URL=https://xxxx.supabase.co
# VERIDEX_SUPABASE_SERVICE_ROLE_KEY=
# VERIDEX_SUPABASE_TABLE=veridex_envelopes
