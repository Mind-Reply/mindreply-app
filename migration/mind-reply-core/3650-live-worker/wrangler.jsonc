{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "3650-live",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-02",
  "compatibility_flags": ["nodejs_compat"],
  "vars": {},
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/monitor/*", "/proof/*", "/metrics", "/mcp"]
  },
  "observability": { "enabled": true },
  "routes": [
    { "pattern": "dubai.mind-reply.com/*", "zone_name": "mind-reply.com" },
    { "pattern": "nyc.mind-reply.com/*", "zone_name": "mind-reply.com" },
    { "pattern": "london.mind-reply.com/*", "zone_name": "mind-reply.com" },
    { "pattern": "sofia.mind-reply.com/*", "zone_name": "mind-reply.com" },
    { "pattern": "tokyo.mind-reply.com/*", "zone_name": "mind-reply.com" },
    { "pattern": "live.shipbythurs.day/*", "zone_name": "shipbythurs.day" }
  ],
  "kv_namespaces": [
    { "binding": "PROOF_VAULT" }
  ]
}
