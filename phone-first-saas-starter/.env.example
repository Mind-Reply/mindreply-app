# Server-only secrets — configure in the hosting secret manager, never in Git.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"

# A11-K Stripe sandbox only. Use a restricted test-mode key with minimum permissions.
STRIPE_SECRET_KEY="rk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"
STRIPE_TRIAL_DAYS="0"

# Subscription Prices — create/approve in the A11-K sandbox before configuring.
STRIPE_PRICE_ID_OPERATOR=""
STRIPE_PRICE_ID_SOVEREIGN=""
STRIPE_PRICE_ID_ENTERPRISE=""

# One-time service Prices — no default or hard-coded Price IDs are used.
STRIPE_PRICE_ID_WEBSITE_COMPLETION=""
STRIPE_PRICE_ID_ENGINEERING_SERVICE=""
STRIPE_PRICE_ID_RESEARCH_SERVICE=""
STRIPE_PRICE_ID_ROBOTICS_SERVICE=""
STRIPE_PRICE_ID_CREATIVE_SERVICE=""
STRIPE_PRICE_ID_ENTERPRISE_SERVICE=""

# Meter names are configured only after corresponding Stripe Billing Meters
# and metered Prices are created and reviewed in the sandbox.
STRIPE_METER_EVENT_NAME_RESEARCH_RUN=""
STRIPE_METER_EVENT_NAME_AGENT_EXECUTION=""
STRIPE_METER_EVENT_NAME_API_REQUEST=""
STRIPE_METER_EVENT_NAME_COMPUTE_UNIT=""
STRIPE_METER_EVENT_NAME_ROBOTICS_RUNTIME=""
STRIPE_METER_EVENT_NAME_DOCUMENT_OPERATION=""

SUPABASE_SERVICE_ROLE_KEY="" # Optional; server-only Storage/admin access.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Client-safe values only.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ_REPLACE_ME"
NEXT_PUBLIC_SENTRY_DSN=""

# Never prefix DATABASE_URL, DIRECT_URL, Stripe secrets, webhook secrets,
# Clerk secret, or SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
