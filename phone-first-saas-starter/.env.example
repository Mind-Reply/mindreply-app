# Server-only secrets
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/postgres?sslmode=require"
CLERK_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_SECRET_KEY="sk_test_REPLACE_ME"
STRIPE_WEBHOOK_SECRET="whsec_REPLACE_ME"

# Optional per-plan overrides. With a Stripe test key, unset values use the
# known MindReply sandbox prices. With a live key, all three live price IDs
# must be supplied explicitly; test price IDs must never be used for live billing.
STRIPE_PRICE_ID_PERSONAL=""
STRIPE_PRICE_ID_BUSINESS=""
STRIPE_PRICE_ID_CREATOR=""
STRIPE_TRIAL_DAYS="14"

SUPABASE_SERVICE_ROLE_KEY="" # Optional; server-only Storage/admin access.
SENTRY_DSN=""
SENTRY_ENVIRONMENT="development"

# Client-safe variables: client code may only read NEXT_PUBLIC_* values.
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_REPLACE_ME"
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJ_REPLACE_ME"
NEXT_PUBLIC_SENTRY_DSN=""

# Never prefix DATABASE_URL, DIRECT_URL, Clerk secret, Stripe secret/webhook secret,
# or SUPABASE_SERVICE_ROLE_KEY with NEXT_PUBLIC_.
