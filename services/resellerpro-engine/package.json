{
  "name": "resellerpro-engine",
  "version": "1.0.0",
  "description": "ResellerPro billing engine - idempotent order provisioning, domain registry integration",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "migrate:latest": "node dist/migrations/index.js",
    "build:with-migrations": "npm run build && npm run migrate:latest"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.43.0",
    "stripe": "^14.21.0",
    "express": "^4.18.2",
    "express-async-errors": "^3.1.1",
    "dotenv": "^16.3.1",
    "zod": "^3.22.4",
    "pino": "^8.17.2",
    "pino-http": "^9.1.0"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.10.6",
    "@types/express": "^4.17.21",
    "tsx": "^4.7.0",
    "eslint": "^8.56.0",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0"
  },
  "engines": {
    "node": ">=20.10.0"
  }
}
